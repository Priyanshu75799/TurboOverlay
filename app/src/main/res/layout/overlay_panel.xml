<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="210dp"
    android:layout_height="wrap_content"
    android:background="#DD121212"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvCpuLive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/placeholder_cpu"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tvBatLive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/placeholder_bat"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/panelDragHandleLeft"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:background="#4481C784"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#222222">

            <ViewFlipper
                android:id="@+id/cpuViewFlipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.PriyanshuDeveloper.turbooverlay.GraphView
                    android:id="@+id/graphView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <GridLayout
                    android:id="@+id/cpuCoreGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:columnCount="2"
                    android:rowCount="4"
                    android:padding="4dp">

                    <TextView android:id="@+id/tvCore0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C0: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCore1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C1: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCore2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C2: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCore3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C3: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCore4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C4: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCore5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C5: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCore6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C6: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvCore7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="C7: --" android:textColor="#BBBBBB" android:textSize="11sp" />
                </GridLayout>

                <LinearLayout
                    android:id="@+id/batteryInfoGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView android:id="@+id/tvBatVoltage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_voltage" android:textColor="#BBBBBB" android:textSize="12sp" />
                    <TextView android:id="@+id/tvBatCurrent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_current" android:textColor="#BBBBBB" android:textSize="12sp" android:layout_marginTop="2dp" />
                    <TextView android:id="@+id/tvBatPower" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_power" android:textColor="#BBBBBB" android:textSize="12sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/netSpeedGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="8dp">
                    <TextView android:id="@+id/tvNetDown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_down" android:textColor="#BBBBBB" android:textSize="11sp" />
                    <TextView android:id="@+id/tvNetUp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_up" android:textColor="#BBBBBB" android:textSize="11sp" android:layout_marginTop="1dp" />
                    <TextView android:id="@+id/tvNetLatency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_latency" android:textColor="#BBBBBB" android:textSize="11sp" android:layout_marginTop="1dp" />
                    <TextView android:id="@+id/tvNetSignal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder_signal" android:textColor="#BBBBBB" android:textSize="11sp" android:layout_marginTop="1dp" />
                </LinearLayout>
            </ViewFlipper>

            <LinearLayout
                android:id="@+id/performancePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">
                <ImageButton
                    android:id="@+id/btnPerfAction"
                    android:layout_width="42dp"
                    android:layout_height="34dp"
                    android:background="@drawable/overlay_icon_button_bg"
                    android:contentDescription="@string/desc_boost"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_boost" />
                <ImageButton
                    android:id="@+id/btnPerfPMAction"
                    android:layout_width="42dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/overlay_icon_button_bg"
                    android:contentDescription="@string/desc_repeat"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_repeat_minute" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:id="@+id/panelDragHandleRight"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:background="#4481C784"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/btnTabCpu"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/overlay_icon_button_bg"
            android:contentDescription="@string/desc_cpu"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_cpu_chip" />
        <ImageButton
            android:id="@+id/btnTabBat"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/overlay_icon_button_bg"
            android:contentDescription="@string/desc_bat"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_battery_temp" />
        <ImageButton
            android:id="@+id/btnTabNet"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/overlay_icon_button_bg"
            android:contentDescription="@string/desc_net"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_net_speed" />
        <ImageButton
            android:id="@+id/btnTabPerf"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/overlay_icon_button_bg"
            android:contentDescription="@string/desc_perf"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_perf_bolt" />
        <ImageButton
            android:id="@+id/btnClosePanel"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/overlay_icon_button_bg"
            android:contentDescription="@string/desc_hide"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_hide_panel" />
    </LinearLayout>

</LinearLayout>
